{
  "name": "@midscene/replay",
  "version": "1.10.2",
  "description": "Playback of computer actions from Midscene log files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/midscene.git",
    "directory": "packages/replay"
  },
  "main": "./dist/lib/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "midscene-replay": "./bin/midscene-replay"
  },
  "files": ["bin", "dist"],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch"
  },
  "dependencies": {
    "@computer-use/libnut": "^4.2.0",
    "clipboardy": "^4.0.0"
  },
  "devDependencies": {
    "@rslib/core": "^0.18.3",
    "@types/node": "^18.0.0",
    "typescript": "^5.8.3"
  }
}
